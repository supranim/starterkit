# Supranim environment (dotenv format).
# Copy to `.env` and adjust. Never commit real secrets.
# Release builds additionally overlay `.env.production` when present.

DB_TYPE=postgres
DB_HOST=localhost
DB_USER=username
DB_NAME=database
DB_PASS=
DB_PORT=5432

# HS256 needs at least 16 chars (128 bits)
JWT_SECRET=change-me-to-at-least-16-chars
